# free key: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your-key-here

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# rate limit (per client IP, all /api/ routes)
RATE_LIMIT_ENABLED=1
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
# number of reverse proxies in front of Django; leave 0 when running runserver directly
RATE_LIMIT_TRUSTED_PROXIES=0

# optional: share cache and rate-limit counters between workers
# REDIS_URL=redis://localhost:6379/1
